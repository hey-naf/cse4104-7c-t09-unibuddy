# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# ---------------------------------------------------------------- database ----
# PostgreSQL connection string from Supabase (Project Settings -> Database)
DATABASE_URL=postgresql://user:password@host:5432/unibuddy

# --------------------------------------------------------------------- auth ----
# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------- ai ----
# Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Optional fallback provider
OPENAI_API_KEY=

# ------------------------------------------------------------ file storage ----
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=study-materials

# ------------------------------------------------------------------- server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --------------------------------------------------------------- frontend ----
# Put these in frontend/.env instead if Vite needs them at build time
VITE_API_BASE_URL=http://localhost:5000/api
